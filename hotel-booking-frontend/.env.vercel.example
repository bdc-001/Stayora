# Stayora frontend — set these in the Vercel project (Settings → Environment Variables).
# Apply to Production (and Preview if you want preview deploys to hit the same API).
# Vite only exposes VITE_* to the browser. Never put secrets here (no sk_*, Mongo, JWT, LLM keys).

# Required — public API origin, no trailing slash
# Plan Trip (/api/trips) needs the Stayora Express API with AGENT_SERVICE_URL configured.
# The legacy demo host (hotel-booking-backend.arnobmahmud.com) does NOT support Plan Trip (404).
VITE_API_BASE_URL=http://localhost:5001

# Required for Stripe checkout (Booking + Plan Trip hotel payments) — publishable key only
VITE_STRIPE_PUB_KEY=pk_test_your_publishable_key
