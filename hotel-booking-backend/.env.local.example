# Copy to .env.local (gitignored). Keep PORT aligned with frontend VITE_API_BASE_URL.
# 5001 avoids macOS AirPlay on 5000 (Control Center). Match frontend VITE_API_BASE_URL.
PORT=5001
FRONTEND_URL=http://localhost:5174
# Google Console redirect URI (add when using Google sign-in locally):
# http://localhost:5001/api/auth/callback/google

# Itinerary agent (REQ-0055): private FastAPI service; token must match its environment
AGENT_SERVICE_URL=http://127.0.0.1:8001
AGENT_SERVICE_TOKEN=
